# GEMINI_API_KEY: Required for server-side Gemini AI features (Payment Recovery, Cash Flow Explanations, AI Copilot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing authentication session cookies (auto-generated fallback in local dev).
JWT_SECRET="replace-with-strong-random-secret"

# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: Optional Razorpay Test/Live mode API credentials.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# EMAIL_PROVIDER_API_KEY / SMTP_FROM: Optional Resend/SMTP credentials for outbound invoice & reminder emails.
RESEND_API_KEY=""
EMAIL_FROM="billing@flowguard.in"

# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID: Optional Meta WhatsApp Business Cloud API credentials.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: Optional when deploying with external Supabase PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
